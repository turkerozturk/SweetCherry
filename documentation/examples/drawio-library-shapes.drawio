        <mxCell id="4" parent="1" vertex="1" value="&lt;a href=&quot;data:page/id,colors-placeholders&quot;&gt;Text link: colors&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;https://www.drawio.com/docs/&quot;&gt;Text link: web&lt;/a&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry as="geometry" x="30" y="160" width="280" height="80" />
