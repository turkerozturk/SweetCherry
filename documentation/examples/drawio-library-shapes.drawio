        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="links" name="Links">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" vertex="1" value="Open library shapes" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" link="data:page/id,library-shapes">
          <mxGeometry as="geometry" x="30" y="30" width="280" height="80" />
