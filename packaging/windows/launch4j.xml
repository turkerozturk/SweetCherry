<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>SweetCherry.jar</jar>
  <outfile>SweetCherry.exe</outfile>
  <errTitle>SweetCherry (Windows x64)</errTitle>
  <chdir>.</chdir>
  <priority>normal</priority>
  <stayAlive>true</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <icon>SweetCherry.ico</icon>
  <singleInstance><mutexName>SweetCherry.Windows.x64</mutexName></singleInstance>
  <jre>
    <!-- Prefer adjacent Java, then JAVA_HOME/PATH, then the Windows registry. -->
    <path>runtime;%JAVA_HOME%;%PATH%</path>
    <minVersion>17</minVersion>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>true</requires64Bit>
    <!-- Command-line Spring options override these defaults without duplicate option values. -->
    <opt>-Dmyapp.desktop.enabled=true</opt>
    <opt>-Dmyapp.openWebBrowserOnStartup=true</opt>
  </jre>
  <messages>
    <startupErr>SweetCherry could not start. Use run.bat for diagnostics and check myapp.log.</startupErr>
    <jreNotFoundErr>Java 17 or newer (64-bit) was not found. Place Java in runtime or install a system Java 17+ runtime.</jreNotFoundErr>
    <launcherErr>SweetCherry launcher failed. Use run.bat for diagnostics.</launcherErr>
  </messages>
</launch4jConfig>
